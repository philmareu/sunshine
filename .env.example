APP_NAME=Sunshine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sunshine
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Searches can run for several minutes; keep this above RunSearch::$timeout.
DB_QUEUE_RETRY_AFTER=500

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sunshine is built for Anthropic. Other providers are untested, and the page reader
# and taste models below are Anthropic model names.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# The scout that searches the web and picks events.
ANTHROPIC_MODEL=claude-sonnet-5-5
# The cheap model that lists the events on each page Sunshine reads itself.
PAGE_READER_MODEL=claude-haiku-5-5
# The cheap model that sums up the family's taste about once a week.
TASTE_MODEL=claude-haiku-5-5
# false leaves every page to the scout's own web fetch, on the main model.
READ_PAGES=true
# How many days ahead the weekly scan looks.
DISCOVERY_DAYS_AHEAD=21
# Where activity photos are kept. Keep it a private disk.
PHOTOS_DISK=local
# The Node binary that runs browser/render.mjs for pages that need a browser.
BROWSER_NODE=node
